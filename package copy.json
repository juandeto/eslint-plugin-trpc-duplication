{
  "name": "eslint-plugin-trpc-usage",
  "version": "0.1.0",
  "description": "ESLint plugin to detect high-frequency tRPC procedure usage",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "trpc-usage": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node ./scripts/add-shebang.cjs",
    "postinstall": "node -e \"const fs=require('node:fs');const cp=require('node:child_process');if(fs.existsSync('./dist/cli.js')){cp.execSync('node ./dist/cli.js cache --if-needed',{stdio:'inherit'});}\"",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "trpc",
    "code-quality"
  ],
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "dependencies": {
    "glob": "^13.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/rule-tester": "^8.54.0",
    "@typescript-eslint/utils": "^8.54.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
